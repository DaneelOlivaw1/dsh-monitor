{
  "name": "dsh-monitor",
  "version": "0.4.0",
  "description": "DeepSeek Harness bundle plugin: /monitor puts an AI supervisor on another session — timer + snapshots + injection tools, judgement left to the model. Ships a 「派生监管者」 header button that derives a supervisor for the session you are viewing.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client/client.js",
    "skills/monitor-supervisor/SKILL.md",
    "cordis.patch.yml",
    "README.zh.md",
    "README.md",
    "templates/**",
    "scripts/**"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "supervisor",
    "monitor",
    "loop"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
